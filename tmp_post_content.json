{"content":"<!DOCTYPE html>\r\n<html lang=\"id\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Layanan Pembuat Kelompok Siswa<\/title>\r\n    <script src=\"https:\/\/cdn.tailwindcss.com\"><\/script>\r\n    <style>\r\n        body {\r\n            box-sizing: border-box;\r\n        }\r\n        .fade-in {\r\n            animation: fadeIn 0.5s ease-in;\r\n        }\r\n        @keyframes fadeIn {\r\n            from { opacity: 0; transform: translateY(10px); }\r\n            to { opacity: 1; transform: translateY(0); }\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body class=\"bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen font-sans\">\r\n    <div class=\"container mx-auto px-4 py-8 max-w-4xl\">\r\n        <!-- Header -->\r\n        <div class=\"text-center mb-8\">\r\n            <h1 class=\"text-4xl font-bold text-gray-800 mb-2\">\ud83c\udfb2 Pembuat Kelompok Siswa<\/h1>\r\n            <p class=\"text-gray-600\">Masukkan daftar siswa dan buat kelompok secara acak dengan mudah<\/p>\r\n        <\/div>\r\n\r\n        <div class=\"grid md:grid-cols-2 gap-8\">\r\n            <!-- Input Section -->\r\n            <div class=\"bg-white rounded-xl shadow-lg p-6\">\r\n                <h2 class=\"text-2xl font-semibold text-gray-800 mb-4 flex items-center\">\r\n                    \ud83d\udcdd Input Data Siswa\r\n                <\/h2>\r\n                \r\n                <div class=\"mb-4\">\r\n                    <label class=\"block text-sm font-medium text-gray-700 mb-2\">Masukkan nama siswa (satu per baris):<\/label>\r\n                    <textarea \r\n                        id=\"studentInput\" \r\n                        class=\"w-full h-40 p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none\"\r\n                        placeholder=\"Contoh:&#10;Ahmad Rizki&#10;Siti Nurhaliza&#10;Budi Santoso&#10;Dewi Lestari&#10;Andi Pratama\"\r\n                    ><\/textarea>\r\n                <\/div>\r\n\r\n                <div class=\"mb-4\">\r\n                    <label class=\"block text-sm font-medium text-gray-700 mb-2\">Jumlah kelompok yang diinginkan:<\/label>\r\n                    <input \r\n                        type=\"number\" \r\n                        id=\"groupCount\" \r\n                        min=\"1\" \r\n                        max=\"20\" \r\n                        value=\"3\"\r\n                        class=\"w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent\"\r\n                    >\r\n                <\/div>\r\n\r\n                <div class=\"flex gap-3\">\r\n                    <button \r\n                        onclick=\"createGroups()\" \r\n                        class=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-200 transform hover:scale-105\"\r\n                    >\r\n                        \ud83c\udfb2 Buat Kelompok\r\n                    <\/button>\r\n                    <button \r\n                        onclick=\"clearAll()\" \r\n                        class=\"bg-gray-500 hover:bg-gray-600 text-white font-semibold py-3 px-4 rounded-lg transition duration-200\"\r\n                    >\r\n                        \ud83d\uddd1\ufe0f Hapus\r\n                    <\/button>\r\n                <\/div>\r\n\r\n                <div id=\"studentCount\" class=\"mt-4 text-sm text-gray-600\"><\/div>\r\n            <\/div>\r\n\r\n            <!-- Results Section -->\r\n            <div class=\"bg-white rounded-xl shadow-lg p-6\">\r\n                <h2 class=\"text-2xl font-semibold text-gray-800 mb-4 flex items-center\">\r\n                    \ud83d\udc65 Hasil Kelompok\r\n                <\/h2>\r\n                \r\n                <div id=\"groupResults\" class=\"space-y-4\">\r\n                    <div class=\"text-center text-gray-500 py-8\">\r\n                        <div class=\"text-6xl mb-4\">\ud83c\udfaf<\/div>\r\n                        <p>Masukkan nama siswa dan klik \"Buat Kelompok\" untuk melihat hasil pembagian kelompok<\/p>\r\n                    <\/div>\r\n                <\/div>\r\n\r\n                <div id=\"groupStats\" class=\"mt-6 p-4 bg-gray-50 rounded-lg hidden\">\r\n                    <h3 class=\"font-semibold text-gray-700 mb-2\">\ud83d\udcca Statistik:<\/h3>\r\n                    <div id=\"statsContent\"><\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n\r\n        <!-- Quick Actions -->\r\n        <div class=\"mt-8 bg-white rounded-xl shadow-lg p-6\">\r\n            <h3 class=\"text-xl font-semibold text-gray-800 mb-4\">\u26a1 Aksi Cepat<\/h3>\r\n            <div class=\"flex flex-wrap gap-3\">\r\n                <button \r\n                    onclick=\"shuffleGroups()\" \r\n                    id=\"shuffleBtn\"\r\n                    class=\"bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed\"\r\n                    disabled\r\n                >\r\n                    \ud83d\udd04 Acak Ulang\r\n                <\/button>\r\n                <button \r\n                    onclick=\"exportGroups()\" \r\n                    id=\"exportBtn\"\r\n                    class=\"bg-purple-600 hover:bg-purple-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed\"\r\n                    disabled\r\n                >\r\n                    \ud83d\udccb Salin Hasil\r\n                <\/button>\r\n                <button \r\n                    onclick=\"loadSampleData()\" \r\n                    class=\"bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200\"\r\n                >\r\n                    \ud83d\udcda Contoh Data\r\n                <\/button>\r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        let currentStudents = [];\r\n        let currentGroups = [];\r\n\r\n        \/\/ Update student count as user types\r\n        document.getElementById('studentInput').addEventListener('input', function() {\r\n            const text = this.value.trim();\r\n            const students = text ? text.split('\\n').filter(name => name.trim() !== '') : [];\r\n            document.getElementById('studentCount').textContent = \r\n                students.length > 0 ? `\ud83d\udcca Total siswa: ${students.length}` : '';\r\n        });\r\n\r\n        function createGroups() {\r\n            const input = document.getElementById('studentInput').value.trim();\r\n            const groupCount = parseInt(document.getElementById('groupCount').value);\r\n\r\n            if (!input) {\r\n                alert('\u26a0\ufe0f Silakan masukkan nama siswa terlebih dahulu!');\r\n                return;\r\n            }\r\n\r\n            if (groupCount < 1) {\r\n                alert('\u26a0\ufe0f Jumlah kelompok harus minimal 1!');\r\n                return;\r\n            }\r\n\r\n            \/\/ Parse students\r\n            currentStudents = input.split('\\n')\r\n                .map(name => name.trim())\r\n                .filter(name => name !== '');\r\n\r\n            if (currentStudents.length === 0) {\r\n                alert('\u26a0\ufe0f Tidak ada nama siswa yang valid!');\r\n                return;\r\n            }\r\n\r\n            if (groupCount > currentStudents.length) {\r\n                alert('\u26a0\ufe0f Jumlah kelompok tidak boleh lebih dari jumlah siswa!');\r\n                return;\r\n            }\r\n\r\n            \/\/ Shuffle students\r\n            const shuffledStudents = [...currentStudents].sort(() => Math.random() - 0.5);\r\n            \r\n            \/\/ Create groups\r\n            currentGroups = [];\r\n            for (let i = 0; i < groupCount; i++) {\r\n                currentGroups.push([]);\r\n            }\r\n\r\n            \/\/ Distribute students\r\n            shuffledStudents.forEach((student, index) => {\r\n                currentGroups[index % groupCount].push(student);\r\n            });\r\n\r\n            displayGroups();\r\n            updateButtons(true);\r\n        }\r\n\r\n        function displayGroups() {\r\n            const resultsDiv = document.getElementById('groupResults');\r\n            const statsDiv = document.getElementById('groupStats');\r\n            const statsContent = document.getElementById('statsContent');\r\n\r\n            let html = '';\r\n            currentGroups.forEach((group, index) => {\r\n                html += `\r\n                    <div class=\"fade-in bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 p-4 rounded-lg\">\r\n                        <h3 class=\"font-semibold text-lg text-gray-800 mb-3 flex items-center\">\r\n                            <span class=\"bg-blue-500 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm mr-3\">\r\n                                ${index + 1}\r\n                            <\/span>\r\n                            Kelompok ${index + 1} (${group.length} siswa)\r\n                        <\/h3>\r\n                        <div class=\"grid gap-2\">\r\n                            ${group.map((student, i) => `\r\n                                <div class=\"bg-white px-3 py-2 rounded-md shadow-sm flex items-center\">\r\n                                    <span class=\"text-gray-500 text-sm mr-3\">${i + 1}.<\/span>\r\n                                    <span class=\"text-gray-800\">${student}<\/span>\r\n                                <\/div>\r\n                            `).join('')}\r\n                        <\/div>\r\n                    <\/div>\r\n                `;\r\n            });\r\n\r\n            resultsDiv.innerHTML = html;\r\n\r\n            \/\/ Show statistics\r\n            const minSize = Math.min(...currentGroups.map(g => g.length));\r\n            const maxSize = Math.max(...currentGroups.map(g => g.length));\r\n            \r\n            statsContent.innerHTML = `\r\n                <div class=\"grid grid-cols-2 gap-4 text-sm\">\r\n                    <div>\r\n                        <span class=\"text-gray-600\">Total siswa:<\/span>\r\n                        <span class=\"font-semibold ml-2\">${currentStudents.length}<\/span>\r\n                    <\/div>\r\n                    <div>\r\n                        <span class=\"text-gray-600\">Jumlah kelompok:<\/span>\r\n                        <span class=\"font-semibold ml-2\">${currentGroups.length}<\/span>\r\n                    <\/div>\r\n                    <div>\r\n                        <span class=\"text-gray-600\">Ukuran terkecil:<\/span>\r\n                        <span class=\"font-semibold ml-2\">${minSize} siswa<\/span>\r\n                    <\/div>\r\n                    <div>\r\n                        <span class=\"text-gray-600\">Ukuran terbesar:<\/span>\r\n                        <span class=\"font-semibold ml-2\">${maxSize} siswa<\/span>\r\n                    <\/div>\r\n                <\/div>\r\n            `;\r\n            \r\n            statsDiv.classList.remove('hidden');\r\n        }\r\n\r\n        function shuffleGroups() {\r\n            if (currentStudents.length === 0) return;\r\n            \r\n            const groupCount = currentGroups.length;\r\n            const shuffledStudents = [...currentStudents].sort(() => Math.random() - 0.5);\r\n            \r\n            \/\/ Reset groups\r\n            currentGroups = [];\r\n            for (let i = 0; i < groupCount; i++) {\r\n                currentGroups.push([]);\r\n            }\r\n\r\n            \/\/ Redistribute\r\n            shuffledStudents.forEach((student, index) => {\r\n                currentGroups[index % groupCount].push(student);\r\n            });\r\n\r\n            displayGroups();\r\n        }\r\n\r\n        function exportGroups() {\r\n            if (currentGroups.length === 0) return;\r\n\r\n            let exportText = '\ud83d\udccb HASIL PEMBAGIAN KELOMPOK\\n';\r\n            exportText += '='.repeat(40) + '\\n\\n';\r\n            \r\n            currentGroups.forEach((group, index) => {\r\n                exportText += `\ud83d\udc65 KELOMPOK ${index + 1} (${group.length} siswa)\\n`;\r\n                exportText += '-'.repeat(25) + '\\n';\r\n                group.forEach((student, i) => {\r\n                    exportText += `${i + 1}. ${student}\\n`;\r\n                });\r\n                exportText += '\\n';\r\n            });\r\n\r\n            exportText += `\ud83d\udcca STATISTIK:\\n`;\r\n            exportText += `\u2022 Total siswa: ${currentStudents.length}\\n`;\r\n            exportText += `\u2022 Jumlah kelompok: ${currentGroups.length}\\n`;\r\n            \r\n            navigator.clipboard.writeText(exportText).then(() => {\r\n                alert('\u2705 Hasil kelompok berhasil disalin ke clipboard!');\r\n            }).catch(() => {\r\n                \/\/ Fallback for older browsers\r\n                const textArea = document.createElement('textarea');\r\n                textArea.value = exportText;\r\n                document.body.appendChild(textArea);\r\n                textArea.select();\r\n                document.execCommand('copy');\r\n                document.body.removeChild(textArea);\r\n                alert('\u2705 Hasil kelompok berhasil disalin!');\r\n            });\r\n        }\r\n\r\n        function loadSampleData() {\r\n            const sampleData = `Ahmad Rizki Pratama\r\nSiti Nurhaliza Dewi\r\nBudi Santoso Wijaya\r\nDewi Lestari Putri\r\nAndi Pratama Kusuma\r\nMaya Sari Indah\r\nRudi Hermawan\r\nFitri Ramadhani\r\nDoni Setiawan\r\nLisa Permata Sari\r\nAgus Suryanto\r\nNina Kartika\r\nEko Prasetyo\r\nRina Maharani\r\nFajar Nugroho`;\r\n            \r\n            document.getElementById('studentInput').value = sampleData;\r\n            document.getElementById('studentInput').dispatchEvent(new Event('input'));\r\n        }\r\n\r\n        function clearAll() {\r\n            document.getElementById('studentInput').value = '';\r\n            document.getElementById('groupCount').value = '3';\r\n            document.getElementById('studentCount').textContent = '';\r\n            document.getElementById('groupResults').innerHTML = `\r\n                <div class=\"text-center text-gray-500 py-8\">\r\n                    <div class=\"text-6xl mb-4\">\ud83c\udfaf<\/div>\r\n                    <p>Masukkan nama siswa dan klik \"Buat Kelompok\" untuk melihat hasil pembagian kelompok<\/p>\r\n                <\/div>\r\n            `;\r\n            document.getElementById('groupStats').classList.add('hidden');\r\n            \r\n            currentStudents = [];\r\n            currentGroups = [];\r\n            updateButtons(false);\r\n        }\r\n\r\n        function updateButtons(enabled) {\r\n            document.getElementById('shuffleBtn').disabled = !enabled;\r\n            document.getElementById('exportBtn').disabled = !enabled;\r\n        }\r\n    <\/script>\r\n<script>(function(){function c(){var b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'9870f668e262df9f',t:'MTc1OTIwNjM5MS4wMDAwMDA='};var a=document.createElement('script');a.nonce='';a.src='\/cdn-cgi\/challenge-platform\/scripts\/jsd\/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();<\/script><\/body>\r\n<\/html>","embed_code":null,"is_html":true}